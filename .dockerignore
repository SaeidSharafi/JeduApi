# VCS, CI & editor metadata
.git
.gitattributes
.gitignore
.github
.forgejo
.gitlab-ci.yml
.editorconfig

# Secrets — never bake into image
.env
.env.*
!.env.example

# Dependencies (installed inside the image)
vendor
node_modules

# Laravel caches — must regenerate for --no-dev package set at runtime
bootstrap/cache/*
!bootstrap/cache/.gitignore

# Runtime state (created by the Dockerfile)
storage
public/storage
public/hot
public/build

# Local dev data & state
docker/typesense-data
.tmp
.scratch
.worktrees
.tinker
.scribe
.idea
.vscode

# Tests & tooling (not needed at runtime)
tests
pest.xml
phpstan.neon
rector.php
pint.json
peck.json
.phpunit.result.cache
laradumps.xml
laradumps.yaml
.DS_Store

# Local tooling & docs
docker-compose*.y*ml
scripts
docs
.ai
.agents
.opencode
graphify-out
