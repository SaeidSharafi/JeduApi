<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <file>app/Enums/PermissionEnum.php</file>
            <file>app/Console/Commands/SetupScribe.php</file>
            <file>app/Providers/ScribeServiceProvider.php</file>
            <file>app/Console/Commands/DeployApplicationCommand.php</file>
            <file>app/Providers/TelescopeServiceProvider.php</file>
            <file>app/Http/Middleware/TelescopeBasicAuth.php</file>
            <file>app/Attributes/DiscountHandler.php</file>
            <file>app/Attributes/ProductDiscountHandler.php</file>
            <file>app/Console/Commands/RegenerateDiscountPrices.php</file>
            <file>app/Console/Commands/Discounts/ClearHandlerCache.php</file>
            <file>app/Data/Casts/AdvancedDateTimeInterfaceCast.php</file>
            <directory>app/Scribe</directory>
            <directory>app/Faker</directory>
            <directory>app/Jobs/Deployment</directory>
            <directory>app/Jobs/Discounts</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="SCOUT_DRIVER" value="null"/>
    </php>
</phpunit>
