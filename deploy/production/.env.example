# Configuration template for the Jedu production stack.
#
#   ./install.sh          copies this to .env, fills in every value below and
#                         starts the stack. Values you have already set here (or
#                         in an existing .env, or on the command line) are kept,
#                         so re-running the installer is safe.
#
# Every key in this file is read exactly once, and which side reads it matters:
#
#   - Keys referenced as ${...} in docker-compose*.yml are substituted by Docker
#     Compose itself.
#   - Everything else is passed into the api/worker containers verbatim and read
#     by Laravel's env(), which translates the literal strings true / false /
#     null / empty into their PHP values. That is why SESSION_DOMAIN=null below
#     means "no domain attribute on the cookie", not the four-letter host "null".
#
#   docker compose config   shows the fully resolved result.

# ─────────────────────────────────────────────────────────────────────────────
# Images
# ─────────────────────────────────────────────────────────────────────────────
# Built and pushed by each repository's CI. The admin image does not exist in
# the registry yet; build it from JeduFront/admin-panel first (see README).
JEDU_API_IMAGE=nexus.jedu.ir/docker-hub/jedu-api:latest
JEDU_SHOP_IMAGE=nexus.jedu.ir/docker-hub/jedu-shop:1.0.0
JEDU_ADMIN_IMAGE=nexus.jedu.ir/docker-hub/jedu-admin:latest

# Base images, pulled through the Nexus docker.io proxy because the production
# host cannot reach Docker Hub directly. The plain docker.io equivalents are in
# the comments; remove the proxy prefix if the host has direct access.
CADDY_IMAGE=nexus.jedu.ir/docker-hub-proxy/library/caddy:2-alpine
# CADDY_IMAGE=caddy:2-alpine
REDIS_IMAGE=nexus.jedu.ir/docker-hub-proxy/library/redis:7-alpine
# REDIS_IMAGE=redis:7-alpine
# The pgroonga build is not optional: a migration runs CREATE EXTENSION pgroonga.
POSTGRES_IMAGE=nexus.jedu.ir/docker-hub-proxy/groonga/pgroonga:latest-alpine-17
# POSTGRES_IMAGE=groonga/pgroonga:latest-alpine-17
# Nexus answers 502 for this path, so Typesense is pulled from Docker Hub. Push a
# copy to nexus.jedu.ir/docker-hub/typesense and use it here if the host cannot
# reach Docker Hub.
TYPESENSE_IMAGE=typesense/typesense:29.0
POSTGRES_MAX_LOCKS=256

# ─────────────────────────────────────────────────────────────────────────────
# Topology — written by install.sh from the answers you give it
# ─────────────────────────────────────────────────────────────────────────────
# Where TLS terminates:
#   caddy     Caddy on this host (self-contained)
#   nginx     this host's nginx (it terminates TLS; no Caddy container)
#   external  another edge (NPMplus/LB) terminates TLS and forwards plain HTTP
EDGE_MODE=caddy

# Who routes hostnames to the containers. Follows the edge, except for
# edge=external where it is chosen: nginx when nginx is installed, else caddy.
# ROUTER=nginx

# Upstream edge addresses/CIDRs, space-separated. Required with edge=external;
# used by Caddy's trusted_proxies and by nginx's real_ip.
EDGE_PROXIES=

# Which compose files form the selected topology. install.sh maintains this.
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=

# ─────────────────────────────────────────────────────────────────────────────
# Domains, TLS and published ports
# ─────────────────────────────────────────────────────────────────────────────
# Each hostname needs an A/AAAA record pointing at this server before the first
# start, otherwise Caddy cannot obtain a certificate for it. Behind an external
# edge the records point at the edge, not at this host.
API_DOMAIN=api.jedu.ir
SHOP_DOMAIN=shop.jedu.ir
ADMIN_DOMAIN=admin.jedu.ir

# Let's Encrypt account for renewal notices. Required with edge=caddy.
ACME_EMAIL=

# What the browser sees. https unless --no-tls (plain http behind the edge).
PUBLIC_SCHEME=https
PUBLIC_PORT=443
HTTP_PORT=80
HTTPS_PORT=443

# Bind address for the routing layer. 0.0.0.0 is fine on a host with no public
# IP; a private IP restricts it further. CADDY_BIND applies when Caddy publishes,
# HTTP_BIND when host nginx listens.
HTTP_BIND=0.0.0.0
CADDY_BIND=0.0.0.0

# Loopback ports for api/shop/admin. Host nginx proxies to these in router=nginx
# mode; they are never reachable from the network.
API_LOOPBACK_PORT=8000
SHOP_LOOPBACK_PORT=8081
ADMIN_LOOPBACK_PORT=8082

# Caddy settings, maintained by install.sh.
CADDYFILE=./Caddyfile
CADDY_GLOBAL_OPTIONS=
CADDY_SITE_ADDRESS_PREFIX=
# Site address and upstream for the admin vhost. With --skip-admin this becomes a
# plain-HTTP placeholder so Caddy neither proxies nor requests a certificate for a
# panel that is not running.
CADDY_ADMIN_SITE=admin.jedu.ir
CADDY_ADMIN_UPSTREAM=admin:80
# Space-separated CIDRs the edge is reached from (behind-edge mode only).
CADDY_TRUSTED_PROXIES=
# Port the browser used, forwarded as X-Forwarded-Port.
CADDY_XFP_PORT=443

# Host nginx paths, referenced by install.sh when router=nginx.
NGINX_TLS_CERT=
NGINX_TLS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Datastores — one mode per service: bundled | external | container
# ─────────────────────────────────────────────────────────────────────────────
#   bundled    run it inside this compose project (default)
#   external   another server or managed service, reached by host:port
#   container  a container of another compose project, reached by name on an
#              existing Docker network (DATASTORE_NETWORK)
#
# An external PostgreSQL must provide the pgroonga extension: the first
# migration runs CREATE EXTENSION pgroonga and the role needs rights to it.
DB_MODE=bundled
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=jedushop
POSTGRES_USER=jedu
POSTGRES_PASSWORD=

REDIS_MODE=bundled
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

TYPESENSE_MODE=bundled
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# Only used when a datastore mode is "container". The network must already
# exist; install.sh verifies it and never creates it.
DATASTORE_NETWORK=jedu-datastores

# ─────────────────────────────────────────────────────────────────────────────
# Secrets
# ─────────────────────────────────────────────────────────────────────────────
# install.sh generates each empty value once and keeps it on later runs. Never
# change POSTGRES_PASSWORD after the database volume exists: the role is created
# with the old password and the API will fail to connect.
APP_KEY=
# Must equal the shop container's REVALIDATE_SECRET, which docker-compose.yml
# passes from this same value. Changing it needs a worker restart to take effect
# (queue workers keep the config they booted with) — the README explains how.
STOREFRONT_REVALIDATE_SECRET=

# Basic auth for https://$API_DOMAIN/horizon. Leaving either value empty makes
# Horizon answer 401 to everyone, which is the safe default.
HORIZON_USERNAME=ops
HORIZON_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Trusted proxies and CORS — written by install.sh, read by config/*.php
# ─────────────────────────────────────────────────────────────────────────────
# Set only when the app sits behind a proxy. "*" means the immediate peer (the
# routing layer); the application then reads X-Forwarded-For/Proto/Host from it.
TRUSTED_PROXIES=

# Browser origins allowed to make cookie-authenticated requests. install.sh
# derives this from the three hostnames. Leave unset to use the defaults in
# config/cors.php (the hosted application's own origins); an empty value denies
# every cross-origin browser request.
# CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=0

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
# Changing APP_NAME also changes HORIZON_PREFIX (the Redis key prefix for every
# queue), so set HORIZON_PREFIX explicitly when migrating an existing deployment.
APP_NAME=Laravel
# HORIZON_PREFIX=laravel_horizon:
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Laravel translates the literal string "null" into PHP null.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ─────────────────────────────────────────────────────────────────────────────
# Mail — OTP and order notifications. Change MAIL_MAILER to smtp and fill the
# host/credentials in before going live; with "log" nothing is delivered.
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=noreply@jedu.ir
MAIL_FROM_NAME=Jedu

# Optional error reporting.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
