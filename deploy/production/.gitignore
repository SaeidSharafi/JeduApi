# Written by install.sh; holds generated secrets and must never be committed.
.env
.env.*
!.env.example
# Persistent database, cache, search, application and Caddy files.
data/
# Rotated copies from --reset-env.
*.bak
# Rendered nginx sites; install.sh regenerates them on every run.
nginx/*.conf
# vhost files moved aside by --replace-nginx-site.
*.jedu-backup-*
