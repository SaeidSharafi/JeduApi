# Reverse proxy for the Jedu production stack — Caddy is the edge.
#
# Every value in {$...} comes from the caddy service environment in
# docker-compose.yml. This file is used when install.sh chooses edge=caddy:
# Caddy obtains and renews Let's Encrypt certificates and publishes 80/443.
#
# CADDY_SITE_ADDRESS_PREFIX is empty here. `--no-tls` writes "http://" into it,
# which also stops Caddy from requesting certificates.
#
# CADDY_ADMIN_SITE is written by install.sh: the admin hostname normally, or a
# plain-HTTP placeholder while --skip-admin keeps the panel out of the stack
# (which also keeps Caddy from requesting a certificate for a site that cannot
# answer).
#
# X-Forwarded-Port matters: the API container listens on 8000, and Laravel would
# otherwise build absolute URLs ending in :8000 when it trusts the proxy.
#
# Validate after editing:
#   docker compose run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile
{
	{$CADDY_GLOBAL_OPTIONS}
}

{$CADDY_SITE_ADDRESS_PREFIX}{$API_DOMAIN} {
	encode zstd gzip
	# The api service binds :8000 inside its own container.
	reverse_proxy api:8000 {
		header_up X-Forwarded-Port {$CADDY_XFP_PORT}
	}
}

{$CADDY_SITE_ADDRESS_PREFIX}{$SHOP_DOMAIN} {
	encode zstd gzip
	# Next's standalone server listens on :80 (PORT=80 in the shop Dockerfile).
	reverse_proxy shop:80 {
		header_up X-Forwarded-Port {$CADDY_XFP_PORT}
	}
}

{$CADDY_ADMIN_SITE} {
	encode zstd gzip
	# nginx serving the built SPA on :80.
	reverse_proxy {$CADDY_ADMIN_UPSTREAM} {
		header_up X-Forwarded-Port {$CADDY_XFP_PORT}
	}
}
