# Laravel application environment for the Jedu production stack.
#
#   The api and worker containers read this file through docker-compose.yml
#   (`env_file: app.env`). Every key here is read by Laravel's env() from
#   config/*.php.
#
#   Docker Compose never reads this file. The deployment itself — images,
#   hostnames, ports, datastores, datastore credentials — lives in .env next to
#   it. docker-compose.yml derives APP_URL, FRONTEND_SHOP_DOMAIN,
#   SANCTUM_STATEFUL_DOMAINS, the database/Redis/Typesense coordinates and the
#   queue/cache drivers from those values, so they are deliberately absent here.
#
#   ./install.sh copies this file to app.env, keeps values already present and
#   regenerates missing secrets. Re-running is safe. On a deployed host edit
#   app.env (never this template); keys added to this template later are appended
#   to app.env by the next install.
#
# Laravel's Dotenv translates the literal strings true / false / null / empty, so
# SESSION_DOMAIN=null means "no domain attribute on the cookie", not the host
# "null". Values shown in comments below are the config/*.php defaults; uncomment
# a line to override one.

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Jedu
# These are fixed by docker-compose.yml from the deployment topology; do not set
# them here. Shown for reference only.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.<domain>
# FRONTEND_SHOP_DOMAIN=https://shop.<domain>
TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# APP_PAGE_SIZE=15

# Generated by install.sh. Changing it invalidates encrypted cookies, sessions
# and any value encrypted with the old key.
APP_KEY=
# During key rotation, list the outgoing key(s) here so old values still decrypt.
# APP_PREVIOUS_KEYS=

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
# stderr keeps container logs inside `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# LOG_STACK=single
# LOG_DEPRECATIONS_CHANNEL=null
# LOG_DAILY_DAYS=14
# LOG_SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Sessions, cookies and Sanctum
# ─────────────────────────────────────────────────────────────────────────────
# SESSION_DRIVER=redis is set by docker-compose.yml.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
# install.sh rewrites this to false when the deployment is plain HTTP.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_PATH=/
# SESSION_PARTITIONED_COOKIE=false

# SANCTUM_STATEFUL_DOMAINS is derived from the three hostnames in .env.
SANCTUM_EXPIRATION=10080
# SANCTUM_TOKEN_PREFIX=

# ─────────────────────────────────────────────────────────────────────────────
# Reverse proxy and CORS — install.sh derives these from the topology
# ─────────────────────────────────────────────────────────────────────────────
# Laravel trusts the immediate peer only ("*"), which is always the routing
# layer because the API publishes no public port.
TRUSTED_PROXIES=
# Browser origins allowed to make cookie-authenticated requests, derived from
# the three hostnames. Leave empty to deny every cross-origin request.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=0
# CORS_ALLOWED_ORIGINS_PATTERNS=

# ─────────────────────────────────────────────────────────────────────────────
# Storefront cache revalidation webhook
# ─────────────────────────────────────────────────────────────────────────────
# Publishing content clears the storefront's Next Data Cache by calling
# POST {STOREFRONT_URL}/api/revalidate with STOREFRONT_REVALIDATE_SECRET.
#
# STOREFRONT_URL is the address the API *container* can reach the storefront on,
# so it is the compose service name — never the browser-facing shop domain.
# STOREFRONT_REVALIDATE_SECRET is generated into .env (not here) because the shop
# container must receive the same value as REVALIDATE_SECRET; docker-compose.yml
# injects it into api and worker.
#
# With either value missing the webhook is a logged no-op and the storefront
# serves cached content until its TTL. After changing the secret, recreate the
# worker: queue workers keep the config they booted with.
STOREFRONT_URL=http://shop:80
STOREFRONT_REVALIDATE_TIMEOUT=3
# STOREFRONT_REVALIDATE_SECRET lives in .env, shared with the shop.
# STOREFRONT_REVALIDATE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Mail — OTP and order notifications
# ─────────────────────────────────────────────────────────────────────────────
# With "log" nothing is delivered. Switch to smtp and fill the credentials in.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@jedu.ir
MAIL_FROM_NAME=Jedu
# MAIL_EHLO_DOMAIN=
# Alternative transports (set MAIL_MAILER to postmark/resend first):
# POSTMARK_TOKEN=
# RESEND_KEY=
# MAIL_LOG_CHANNEL=

# ─────────────────────────────────────────────────────────────────────────────
# Horizon (queue dashboard at https://$API_DOMAIN/horizon)
# ─────────────────────────────────────────────────────────────────────────────
# Leaving either value empty makes Horizon answer 401 to everyone.
HORIZON_USERNAME=ops
HORIZON_PASSWORD=
# HORIZON_PREFIX defaults to the slug of APP_NAME plus "_horizon:". Set it
# explicitly when migrating an existing deployment or changing APP_NAME.
# HORIZON_PREFIX=jedu_horizon:
# HORIZON_NAME=
# HORIZON_PATH=horizon
# HORIZON_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# Order, discount and import jobs
# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND_SHOP_DOMAIN is derived from SHOP_DOMAIN in .env.
FRONTEND_ORDER_PAYMENT_URL=/profile/student/financial-reports/transaction-details
FRONTEND_TOPUP_PAYMENT_URL=/profile/student/financial-reports/payment-details
ORDER_ABANDONMENT_MINUTES=30
DISCOUNT_RESERVATION_HOLD_MINUTES=30
# ORDER_PROVISIONING_TRIGGER: any_payment (default) or manual_approval.
# ORDER_PROVISIONING_TRIGGER=any_payment
# ORDER_INCREMENT_PATTERN=simple
# ORDER_INCREMENT_PREFIX=ORD-
# ORDER_INCREMENT_PADDING=9
# ORDER_INCREMENT_START=100000001
# IMPORT_EXPORT_RETENTION_HOURS=24
# TEMPORARY_URL_EXPIRY_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Payment gateways
# ─────────────────────────────────────────────────────────────────────────────
# Mellat (درگاه ملت). Enabled in config/payments.php; set every credential or
# the gateway fails at checkout.
# MELLAT_TERMINAL_ID=
# MELLAT_USERNAME=
# MELLAT_PASSWORD=
# MELLAT_TEST_MODE=false
# MELLAT_IMS_BANK_ACCOUNT_NUMBER=
# MELLAT_CALLBACK_URL defaults to APP_URL/api/v1/shop/payment/gateway/callback.
# MELLAT_CALLBACK_URL=
# MELLAT_SERVER_URL=https://bpm.shaparak.ir/pgwchannel/services/pgw?wsdl
# MELLAT_GATEWAY_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat
# MELLAT_TEST_SERVER_URL=https://sandbox.banktest.ir/mellat/bpm.shaparak.ir/pgwchannel/services/pgw?wsdl
# MELLAT_TEST_GATEWAY_URL=https://sandbox.banktest.ir/mellat/bpm.shaparak.ir/pgwchannel/startpay.mellat

# Digipay (دیجی‌پی)
# DIGIPAY_CLIENT_ID=
# DIGIPAY_CLIENT_SECRET=
# DIGIPAY_USERNAME=
# DIGIPAY_PASSWORD=
# DIGIPAY_SANDBOX_MODE=false
# DIGIPAY_ALLOW_PARTIAL_REFUND=false
# DIGIPAY_TIMEOUT=30
# DIGIPAY_RETRY_TIMES=2
# DIGIPAY_RETRY_DELAY=500
# DIGIPAY_LOGGING=true
# DIGIPAY_LOG_CHANNEL=digipay

# Bank transfer and wallet: the IMS account number shown on the receipt.
# BANK_TRANSFER_IMS_BANK_ACCOUNT_NUMBER=
# WALLET_IMS_BANK_ACCOUNT_NUMBER=

# E2E payment simulator. Leave disabled in production.
# PAYMENT_SIMULATOR_ENABLED=false
# PAYMENT_SIMULATOR_URL=http://payment-simulator
# PAYMENT_SIMULATOR_SECRET=
# PAYMENT_SIMULATOR_INITIATE_PATH=/api/v1/attempts
# PAYMENT_SIMULATOR_TIMEOUT=10

# ─────────────────────────────────────────────────────────────────────────────
# SMS
# ─────────────────────────────────────────────────────────────────────────────
# The admin panel stores gateway and notification settings in the database; a
# stored row wins field by field. These env values are the defaults used until a
# row exists, so a never-saved gateway still sends with a complete config.
# SMS_IPPANEL_ENABLED=true
# IPPANEL_FROM=1000
# IPPANEL_API_KEY=
# IPPANEL_SANDBOX=false

# Notification patterns: enabled + pattern_code per notification.
# SMS_OTP_ENABLED=true
# SMS_OTP_PATTERN=mdoe1j1587
# SMS_REFUND_ENABLED=true
# SMS_REFUND_PATTERN=
# SMS_ORDER_PAID_ENABLED=false
# SMS_ORDER_PAID_PATTERN=
# SMS_ENROLLMENT_READY_ENABLED=false
# SMS_ENROLLMENT_READY_PATTERN=
# SMS_WALLET_CREDITED_ENABLED=false
# SMS_WALLET_CREDITED_PATTERN=

# ─────────────────────────────────────────────────────────────────────────────
# Provisioning providers
# ─────────────────────────────────────────────────────────────────────────────
# Same rule as SMS: the admin panel's stored setting wins field by field, these
# are the defaults for a provider that has never been saved.
# IMS_ENABLED=false
# IMS_BASE_URL=
# IMS_API_KEY=
# IMS_TIMEOUT=15

# MOODLE_ENABLED=false
# MOODLE_BASE_URL=
# MOODLE_TOKEN=
# MOODLE_AUTH_USERKEY_TOKEN=
# MOODLE_DEFAULT_ROLE_ID=5
# MOODLE_LOGIN_REDIRECT_SCRIPT=/my/
# MOODLE_TIMEOUT=15

# SPOTPLAYER_ENABLED=false
# SPOTPLAYER_ENDPOINT=https://panel.spotplayer.ir/license/edit/
# SPOTPLAYER_API_KEY=
# SPOTPLAYER_SANDBOX=false
# SPOTPLAYER_TIMEOUT=15

# SKYROOM_ENABLED=false
# SKYROOM_BASE_URL=https://www.skyroom.online/skyroom/api
# SKYROOM_API_KEY=

# NILIROOM_ENABLED=false
# NILIROOM_BASE_URL=
# NILIROOM_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment webhook (POST /api/v1/webhooks/github-deployer)
# ─────────────────────────────────────────────────────────────────────────────
# The endpoint verifies X-Hub-Signature-256 with GITHUB_WEBHOOK_SECRET; without
# a secret every delivery is rejected. GIT_USERNAME / GIT_PAT are used by the
# deployment jobs when they pull the repository.
# GITHUB_WEBHOOK_SECRET=
# GIT_USERNAME=
# GIT_PAT=

# ─────────────────────────────────────────────────────────────────────────────
# Storage and search
# ─────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
MEDIABLE_DEFAULT_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# SCOUT_DRIVER can be overridden in .env (docker-compose.yml defaults it to
# typesense). TYPESENSE_* / CACHE_STORE / QUEUE_CONNECTION / REDIS_* are set by
# docker-compose.yml from the datastore modes in .env.
# CACHE_PREFIX=
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=120
# SCOUT_PREFIX=
# SEARCH_VECTOR_K=6
# SEARCH_VECTOR_DISTANCE_THRESHOLD=0.15
# SEARCH_VECTOR_RETRY_DISTANCE_THRESHOLD=0.16
# SEARCH_MIN_KEYWORD_RESULTS=1
# SCOUT_QUEUE=false
# SCOUT_IDENTIFY=false
# TYPESENSE_CONNECTION_TIMEOUT_SECONDS=2
# TYPESENSE_NUM_RETRIES=3
# TYPESENSE_RETRY_INTERVAL_SECONDS=1
# TYPESENSE_HEALTHCHECK_INTERVAL_SECONDS=30
# TYPESENSE_MAX_TOTAL_RESULTS=1000

# Catalog tuning
# BUNDLES_ALLOW_REPEATED_PRODUCTABLES=true
# BUNDLES_MAX_COMPONENTS=30
# PRODUCT_AVAILABILITY_USE_DENORMALIZED=true

# ─────────────────────────────────────────────────────────────────────────────
# Error reporting
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_SAMPLE_RATE=

# ─────────────────────────────────────────────────────────────────────────────
# E2E — never enable these in production
# ─────────────────────────────────────────────────────────────────────────────
# E2E_CONTROL_KEY=
# E2E_QUEUE=e2e
# E2E_MEDIA_DISK=e2e
# E2E_STORAGE_PATH=
# E2E_REDIS_DB=2
# E2E_REDIS_CACHE_DB=3
# E2E_REDIS_LOCK_DB=4
# EMAIL_USE_FAKE_EMAIL=false
# EMAIL_FAKE_EMAIL_DOMAIN=example.com
