# Managed by deploy/production/install.sh for the Jedu production stack.
# Regenerated on every run; do not edit in place.
#
# Template: edge=nginx — this host's nginx terminates TLS. install.sh renders it
# into nginx/jedu-docker.conf, installs it into nginx's include directory and
# reloads nginx (or prints it with --emit-nginx-conf).
#
# The certificate must cover all three server names (one SAN certificate); ACME
# renewal and the http->https redirect happen here, not in the containers.

map $http_upgrade $jedu_connection_upgrade {
    default upgrade;
    ''      close;
}

# Port 80: ACME HTTP-01 challenges and the redirect to https.
server {
    listen __HTTP_LISTEN__;
    server_name __API_DOMAIN__ __SHOP_DOMAIN__ __ADMIN_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen __LISTEN_TLS__
    __HTTP2_LINE__
    server_name __API_DOMAIN__;

    ssl_certificate     __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:JEDU_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 50M;

    location / {
        proxy_pass http://__API_UPSTREAM__;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port __XFP_PORT__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $jedu_connection_upgrade;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}

server {
    listen __LISTEN_TLS__
    __HTTP2_LINE__
    server_name __SHOP_DOMAIN__;

    ssl_certificate     __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:JEDU_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 50M;

    location / {
        proxy_pass http://__SHOP_UPSTREAM__;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port __XFP_PORT__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $jedu_connection_upgrade;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}

# __ADMIN_BEGIN__
server {
    listen __LISTEN_TLS__
    __HTTP2_LINE__
    server_name __ADMIN_DOMAIN__;

    ssl_certificate     __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:JEDU_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 50M;

    location / {
        proxy_pass http://__ADMIN_UPSTREAM__;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port __XFP_PORT__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $jedu_connection_upgrade;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}
