# Managed by deploy/production/install.sh for the Jedu production stack.
# Regenerated on every run; do not edit in place.
#
# Template: edge=external, router=nginx — an upstream edge (NPMplus, a load
# balancer, another server) terminates TLS; this nginx only routes hostnames to
# the containers over plain HTTP and never serves certificates.
#
# real_ip is what makes the app see the visitor instead of the edge:
#   - set_real_ip_from must name the edge only, never 0.0.0.0/0;
#   - recursive mode walks X-Forwarded-For right-to-left, so a client-supplied
#     left-most entry cannot spoof the address.
# The forwarded header is then single-valued, which keeps TRUSTED_PROXIES=* safe.

map $http_upgrade $jedu_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen __HTTP_LISTEN__;
    server_name __API_DOMAIN__;

    __REAL_IP_LINES__

    client_max_body_size 50M;

    location / {
        proxy_pass http://__API_UPSTREAM__;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto __XFP_PROTO__;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port __XFP_PORT__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $jedu_connection_upgrade;
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}

