includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon


parameters:

    tmpDir: storage/framework/cache/phpstan

    paths:
        - app/

    level: 6

    # Models in this codebase define casts via the casts() method (Laravel 11+
    # convention). Larastan only reads them when this flag is enabled.
    parseModelCastsMethod: true
    treatPhpDocTypesAsCertain: false
    excludePaths:
        - 'app/Data/'
        - 'app/Scribe/'

    stubFiles:
            - stubs/Mediable.stub
