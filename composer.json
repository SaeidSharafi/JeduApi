{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "acecr-qazvin/jedu-shop",
    "type": "project",
    "description": "ACECR Qazvin (جهاددانشگاهی قزوین) Jedu EShop API Application",
    "keywords": [
        "acecr",
        "jedu",
        "eshop",
        "api"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-soap": "*",
        "hekmatinasser/verta": "^8.5",
        "iazaran/smart-cache": "^1.3",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.46",
        "laravel/nightwatch": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.19",
        "laravel/telescope": "^5.7",
        "laravel/tinker": "^2.10.1",
        "nunomaduro/essentials": "@dev",
        "plank/laravel-mediable": "^6.3",
        "sadegh19b/laravel-persian-validation": "^2.0",
        "saeidsharafi/laravel-permission-generator": "^1.1",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-permission": "^6.18",
        "spatie/laravel-query-builder": "^6.3",
        "spatie/laravel-webhook-client": "^3.4",
        "typesense/typesense-php": "^5.1"
    },
    "require-dev": {
        "ext-curl": "*",
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "^5.1",
        "laradumps/laradumps": "^4.0",
        "larastan/larastan": "^3.3",
        "laravel/boost": "^2.1",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.22",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/mock-final-classes": "^1.2",
        "peckphp/peck": "^0.1.3",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-stressless": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "rector/rector": "^2.0.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "lint": [
            "pint"
        ],
        "refactor": "rector",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:typos": "peck",
        "test:typos-ignore": "peck --ignore-all",
        "test:lint": [
            "pint --test"
        ],
        "test:unit": "pest --parallel --coverage --exactly=100.0",
        "test:types": "phpstan",
        "test:refactor": "rector --dry-run",
        "test": [
            "@test:type-coverage",
            "@test:typos",
            "@test:unit",
            "@test:lint",
            "@test:types",
            "@test:refactor"
        ],
        "fresh-dev": [
            "php artisan migrate:fresh --force",
            "php artisan db:seed --class=DemoSeeder"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
